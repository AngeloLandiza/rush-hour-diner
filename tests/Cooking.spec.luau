--!strict
local TestLib = require("../tools/testlib")
local describe, it, expect = TestLib.describe, TestLib.it, TestLib.expect
local Cooking = require("../src/shared/Logic/Cooking")
local Dishes = require("../src/shared/Config/Dishes")
local Types = require("../src/shared/Contracts/Types")

local sched: Types.CookSchedule = {
	cookSeconds = 3,
	flipWindowSeconds = 2.5,
	perfectSeconds = 0.8,
	finishSeconds = 2,
	burnSeconds = 8,
}

local function idle(): Types.StationState
	return { plotId = 1, slot = 1, stationId = "Grill", phase = "Idle", dishId = "Burger", phaseStartedAt = 0 }
end

local function started(at: number): Types.StationState
	local ok, s = Cooking.applyAction(idle(), "Start", at, sched, 42)
	assert(ok)
	return s
end

describe("Cooking.schedule", function()
	it("matches dish config at base speed", function()
		local s = Cooking.schedule("Burger", {})
		local d = Dishes.Defs.Burger
		expect(s.cookSeconds).toBe(d.cookSeconds)
		expect(s.finishSeconds).toBe(d.finishSeconds)
		expect(s.flipWindowSeconds).toBe(d.flipWindowSeconds)
		expect(s.perfectSeconds).toBe(d.perfectSeconds)
		expect(s.burnSeconds).toBe(d.burnSeconds)
	end)
	it("speed upgrade divides cook and finish only for that station", function()
		local fast = Cooking.schedule("Burger", { GrillSpeed = 1 })
		local base = Cooking.schedule("Burger", {})
		expect(fast.cookSeconds).toBeLessThan(base.cookSeconds)
		expect(fast.finishSeconds).toBeLessThan(base.finishSeconds)
		expect(fast.flipWindowSeconds).toBe(base.flipWindowSeconds)
		expect(Cooking.schedule("Fries", { GrillSpeed = 1 }).cookSeconds).toBe(Dishes.Defs.Fries.cookSeconds)
	end)
end)

describe("Cooking.applyAction", function()
	it("Start from Idle begins Cooking", function()
		local s = started(100)
		expect(s.phase).toBe("Cooking")
		expect(s.phaseStartedAt).toBe(100)
		expect(s.phaseEndsAt).toBe(103)
		expect(s.cookerUserId).toBe(42)
	end)
	it("does not mutate the input", function()
		local input = idle()
		Cooking.applyAction(input, "Start", 5, sched, 1)
		expect(input.phase).toBe("Idle")
		expect(input.phaseEndsAt).toBe(nil)
	end)
	it("Flip within perfectSeconds is Perfect", function()
		local s = started(0)
		local ok, s2 = Cooking.applyAction(s, "Flip", 3.5, sched, 42)
		expect(ok).toBe(true)
		expect(s2.phase).toBe("Finishing")
		expect(s2.flipQuality).toBe("Perfect")
		expect(s2.phaseEndsAt).toBe(5.5)
	end)
	it("Flip exactly at the perfect boundary is Perfect, just after is Good", function()
		local s = started(0)
		local _, a = Cooking.applyAction(s, "Flip", 3.8, sched, 42)
		local _, b = Cooking.applyAction(s, "Flip", 3.81, sched, 42)
		expect(a.flipQuality).toBe("Perfect")
		expect(b.flipQuality).toBe("Good")
	end)
	it("Flip as the window opens is Perfect", function()
		local _, s = Cooking.applyAction(started(0), "Flip", 3, sched, 42)
		expect(s.flipQuality).toBe("Perfect")
	end)
	it("Flip at the last moment of the window is Good", function()
		local ok, s = Cooking.applyAction(started(0), "Flip", 5.49, sched, 42)
		expect(ok).toBe(true)
		expect(s.flipQuality).toBe("Good")
	end)
	it("Flip once the window closes fails (dish is burnt)", function()
		local s = started(0)
		local ok, s2 = Cooking.applyAction(s, "Flip", 5.5, sched, 42)
		expect(ok).toBe(false)
		expect(s2.phase).toBe("Cooking") -- unchanged clone
		expect(Cooking.advance(s, 5.5, sched).phase).toBe("Burnt")
	end)
	it("Flip too early (during Cooking) is invalid", function()
		local s = started(0)
		local ok, s2 = Cooking.applyAction(s, "Flip", 1, sched, 42)
		expect(ok).toBe(false)
		expect(s2).toEqual(s)
		expect(s2 == s).toBe(false)
	end)
	it("Collect on Ready returns the quality and goes Idle", function()
		local _, fin = Cooking.applyAction(started(0), "Flip", 3.2, sched, 42)
		local ok, s, quality = Cooking.applyAction(fin, "Collect", 6, sched, 42)
		expect(ok).toBe(true)
		expect(quality).toBe("Perfect")
		expect(s.phase).toBe("Idle")
		expect(s.phaseEndsAt).toBe(nil)
		expect(s.flipQuality).toBe(nil)
		expect(s.cookerUserId).toBe(nil)
	end)
	it("Collect returns Good quality too", function()
		local _, fin = Cooking.applyAction(started(0), "Flip", 4.5, sched, 42)
		local _, _, quality = Cooking.applyAction(fin, "Collect", 7, sched, 42)
		expect(quality).toBe("Good")
	end)
	it("Collect before Ready is invalid", function()
		local _, fin = Cooking.applyAction(started(0), "Flip", 3.2, sched, 42)
		local ok, s, quality = Cooking.applyAction(fin, "Collect", 4, sched, 42)
		expect(ok).toBe(false)
		expect(quality).toBe(nil)
		expect(s.phase).toBe("Finishing")
	end)
	it("Collect on Idle is invalid", function()
		local ok, s, q = Cooking.applyAction(idle(), "Collect", 1, sched, 1)
		expect(ok).toBe(false)
		expect(q).toBe(nil)
		expect(s.phase).toBe("Idle")
	end)
	it("Start while busy is invalid", function()
		local s = started(0)
		local ok, s2 = Cooking.applyAction(s, "Start", 1, sched, 99)
		expect(ok).toBe(false)
		expect(s2.cookerUserId).toBe(42)
	end)
	it("Clear after a missed flip window advances to Burnt first, then clears", function()
		local ok, s = Cooking.applyAction(started(0), "Clear", 6, sched, 42)
		expect(ok).toBe(true)
		expect(s.phase).toBe("Idle")
	end)
	it("Clear works once burnt", function()
		local burnt = Cooking.advance(started(0), 20, sched)
		expect(burnt.phase).toBe("Burnt")
		local ok, s = Cooking.applyAction(burnt, "Clear", 20, sched, 42)
		expect(ok).toBe(true)
		expect(s.phase).toBe("Idle")
		expect(s.flipQuality).toBe(nil)
	end)
	it("Clear on a non-burnt station is invalid", function()
		local ok = Cooking.applyAction(idle(), "Clear", 1, sched, 1)
		expect(ok).toBe(false)
		local ok2 = Cooking.applyAction(started(0), "Clear", 1, sched, 1)
		expect(ok2).toBe(false)
	end)
	it("Collect after the burn timeout fails", function()
		local _, fin = Cooking.applyAction(started(0), "Flip", 3.2, sched, 42)
		-- Finishing ends at 5.2, Ready until 13.2
		local ok = Cooking.applyAction(fin, "Collect", 13.2, sched, 42)
		expect(ok).toBe(false)
		local ok2 = Cooking.applyAction(fin, "Collect", 13.1, sched, 42)
		expect(ok2).toBe(true)
	end)
end)

describe("Cooking.advance", function()
	it("does nothing before the phase ends", function()
		local s = started(0)
		expect(Cooking.advance(s, 2.99, sched)).toEqual(s)
	end)
	it("Cooking -> NeedsFlip at the end, chaining from phaseEndsAt", function()
		local s = Cooking.advance(started(10), 13.5, sched)
		expect(s.phase).toBe("NeedsFlip")
		expect(s.phaseStartedAt).toBe(13)
		expect(s.phaseEndsAt).toBe(15.5)
	end)
	it("NeedsFlip -> Burnt on timeout", function()
		local s = Cooking.advance(started(0), 5.5, sched)
		expect(s.phase).toBe("Burnt")
		expect(s.flipQuality).toBe("Burnt")
		expect(s.phaseStartedAt).toBe(5.5)
		expect(s.phaseEndsAt).toBe(nil)
	end)
	it("Finishing -> Ready chaining from the previous end", function()
		local _, fin = Cooking.applyAction(started(0), "Flip", 3.2, sched, 42)
		local s = Cooking.advance(fin, 9, sched)
		expect(s.phase).toBe("Ready")
		expect(s.phaseStartedAt).toBe(5.2)
		expect(s.phaseEndsAt).toBe(13.2)
		expect(s.flipQuality).toBe("Perfect")
	end)
	it("Ready -> Burnt after burnSeconds", function()
		local _, fin = Cooking.applyAction(started(0), "Flip", 3.2, sched, 42)
		local s = Cooking.advance(fin, 14, sched)
		expect(s.phase).toBe("Burnt")
		expect(s.phaseStartedAt).toBe(13.2)
		expect(s.flipQuality).toBe("Burnt")
	end)
	it("handles Cooking -> NeedsFlip -> Burnt in one long gap", function()
		local s = Cooking.advance(started(0), 1000, sched)
		expect(s.phase).toBe("Burnt")
		expect(s.phaseStartedAt).toBe(5.5)
	end)
	it("handles Finishing -> Ready -> Burnt in one long gap", function()
		local _, fin = Cooking.applyAction(started(0), "Flip", 3.2, sched, 42)
		local s = Cooking.advance(fin, 1000, sched)
		expect(s.phase).toBe("Burnt")
		expect(s.phaseStartedAt).toBe(13.2)
	end)
	it("Idle and Burnt are stable", function()
		expect(Cooking.advance(idle(), 1e9, sched).phase).toBe("Idle")
		local burnt = Cooking.advance(started(0), 100, sched)
		expect(Cooking.advance(burnt, 1e9, sched)).toEqual(burnt)
	end)
	it("never mutates the input and returns a new table", function()
		local s = started(0)
		local out = Cooking.advance(s, 4, sched)
		expect(s.phase).toBe("Cooking")
		expect(out == s).toBe(false)
	end)
	it("applyAction advances first: a Flip arriving in a later window works after a long Cooking gap", function()
		-- State still says Cooking but time is inside the NeedsFlip window.
		local ok, s = Cooking.applyAction(started(0), "Flip", 3.3, sched, 42)
		expect(ok).toBe(true)
		expect(s.flipQuality).toBe("Perfect")
	end)
end)
