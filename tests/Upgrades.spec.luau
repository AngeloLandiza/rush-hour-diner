--!strict
local TestLib = require("../tools/testlib")
local describe, it, expect = TestLib.describe, TestLib.it, TestLib.expect

local Upgrades = require("../src/shared/Logic/Upgrades")
local Config = require("../src/shared/Config/Upgrades")
local Timings = require("../src/shared/Config/Timings")

describe("Upgrades", function()
	it("getLevel defaults to 0", function()
		expect(Upgrades.getLevel({}, "Tips")).toBe(0)
		expect(Upgrades.getLevel({ Tips = 2 }, "Tips")).toBe(2)
	end)
	it("nextCost walks the cost table and ends at nil", function()
		expect(Upgrades.nextCost({}, "Seating")).toBe(Config.Defs.Seating.costs[1])
		expect(Upgrades.nextCost({ Seating = 2 }, "Seating")).toBe(Config.Defs.Seating.costs[3])
		expect(Upgrades.nextCost({ Seating = 3 }, "Seating")).toBe(nil)
		expect(Upgrades.nextCost({}, "Nope")).toBe(nil)
	end)
	it("canBuy reports Unknown, Maxed, TooPoor and ok", function()
		local cost = Config.Defs.Tips.costs[1]
		local ok, reason = Upgrades.canBuy({}, 10 ^ 9, "Nope")
		expect(ok).toBe(false)
		expect(reason).toBe("Unknown")
		ok, reason = Upgrades.canBuy({ Tips = 2 }, 10 ^ 9, "Tips")
		expect(ok).toBe(false)
		expect(reason).toBe("Maxed")
		ok, reason = Upgrades.canBuy({}, cost - 1, "Tips")
		expect(ok).toBe(false)
		expect(reason).toBe("TooPoor")
		ok, reason = Upgrades.canBuy({}, cost, "Tips")
		expect(ok).toBe(true)
		expect(reason).toBe(nil)
	end)
	it("stationSpeedMultiplier only affects its own station", function()
		local m = Config.Defs.GrillSpeed.effect
		expect(Upgrades.stationSpeedMultiplier({}, "Grill")).toBe(1)
		expect(Upgrades.stationSpeedMultiplier({ GrillSpeed = 1 }, "Grill")).toBeGreaterThan(1)
		expect(Upgrades.stationSpeedMultiplier({ GrillSpeed = 1 }, "Fryer")).toBe(1)
		expect(m.kind).toBe("StationSpeed")
	end)
	it("stationSpeedMultiplier clamps corrupt levels", function()
		expect(Upgrades.stationSpeedMultiplier({ GrillSpeed = 99 }, "Grill")).toBe(
			Upgrades.stationSpeedMultiplier({ GrillSpeed = 1 }, "Grill")
		)
	end)
	it("seatCount starts at base and caps at max", function()
		expect(Upgrades.seatCount({})).toBe(Timings.Seats.Base)
		expect(Upgrades.seatCount({ Seating = 3 })).toBe(Timings.Seats.Base + 3)
		expect(Upgrades.seatCount({ Seating = 50 })).toBeAtMost(Timings.Seats.Max)
	end)
	it("patience and tip multipliers scale with level", function()
		expect(Upgrades.patienceMultiplier({})).toBe(1)
		expect(Upgrades.patienceMultiplier({ Patience = 1 })).toBeNear(1 + Config.Defs.Patience.effect.bonusPerLevel)
		expect(Upgrades.tipMultiplier({})).toBe(1)
		expect(Upgrades.tipMultiplier({ Tips = 2 })).toBeNear(1 + 2 * Config.Defs.Tips.effect.bonusPerLevel)
	end)
	it("decor tier and tip pct", function()
		expect(Upgrades.decorTier({})).toBe(0)
		expect(Upgrades.decorTier({ Decor = 2 })).toBe(2)
		expect(Upgrades.decorTipPct({})).toBe(0)
		expect(Upgrades.decorTipPct({ Decor = 2 })).toBeNear(2 * Config.Defs.Decor.effect.tipPctPerLevel)
	end)
	it("hasAutoServer", function()
		expect(Upgrades.hasAutoServer({})).toBe(false)
		expect(Upgrades.hasAutoServer({ AutoServer = 1 })).toBe(true)
	end)
	it("totalLevels sums to 13 when everything is maxed", function()
		local all = {}
		for id, def in Config.Defs do
			all[id] = def.maxLevel
		end
		expect(Upgrades.totalLevels(all)).toBe(13)
		expect(Upgrades.totalLevels({})).toBe(0)
		expect(Upgrades.totalLevels({ Tips = 1, Seating = 2 })).toBe(3)
	end)
	it("every def's costs are strictly increasing per upgrade", function()
		for _, def in Config.Defs do
			for i = 2, #def.costs do
				expect(def.costs[i]).toBeGreaterThan(def.costs[i - 1])
			end
		end
	end)
end)
