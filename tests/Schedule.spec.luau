--!strict
local TestLib = require("../tools/testlib")
local describe, it, expect = TestLib.describe, TestLib.it, TestLib.expect

local Schedule = require("../src/shared/Logic/Schedule")
local Timings = require("../src/shared/Config/Timings")

local HOUR = Timings.RushHour.IntervalSeconds
local DUR = Timings.RushHour.DurationSeconds
local BASE = 1700000000 - (1700000000 % HOUR) -- an exact :00

describe("Schedule.rushHourState", function()
	it("is active at the exact start", function()
		local s = Schedule.rushHourState(BASE)
		expect(s.active).toBe(true)
		expect(s.startedAt).toBe(BASE)
		expect(s.endsAt).toBe(BASE + DUR)
		expect(s.nextAt).toBe(BASE + HOUR)
	end)
	it("is active one second before the end", function()
		local s = Schedule.rushHourState(BASE + DUR - 1)
		expect(s.active).toBe(true)
		expect(s.startedAt).toBe(BASE)
	end)
	it("is inactive exactly at the end", function()
		local s = Schedule.rushHourState(BASE + DUR)
		expect(s.active).toBe(false)
		expect(s.startedAt).toBe(nil)
		expect(s.endsAt).toBe(nil)
		expect(s.nextAt).toBe(BASE + HOUR)
	end)
	it("is inactive one second before the next start", function()
		local s = Schedule.rushHourState(BASE + HOUR - 1)
		expect(s.active).toBe(false)
		expect(s.nextAt).toBe(BASE + HOUR)
	end)
	it("handles fractional times", function()
		expect(Schedule.rushHourState(BASE + 0.5).active).toBe(true)
	end)
end)

describe("Schedule.nextRushHourAt", function()
	it("is strictly after now", function()
		expect(Schedule.nextRushHourAt(BASE)).toBe(BASE + HOUR)
		expect(Schedule.nextRushHourAt(BASE - 1)).toBe(BASE)
		expect(Schedule.nextRushHourAt(BASE + 100)).toBe(BASE + HOUR)
	end)
end)

describe("Schedule.nextMenuDropAt", function()
	-- Day 19672 (2023-11-11) is a Saturday.
	local satDrop = 1699718400 -- Saturday 16:00 UTC
	it("finds the same-day drop before 16:00", function()
		expect(Schedule.nextMenuDropAt(satDrop - 1)).toBe(satDrop)
	end)
	it("is strictly after an exact drop time", function()
		expect(Schedule.nextMenuDropAt(satDrop)).toBe(satDrop + 7 * 86400)
	end)
	it("finds the drop from earlier in the week", function()
		expect(Schedule.nextMenuDropAt(satDrop - 3 * 86400)).toBe(satDrop)
	end)
	it("rolls to next week after the drop", function()
		expect(Schedule.nextMenuDropAt(satDrop + 1)).toBe(satDrop + 7 * 86400)
	end)
	it("lands on the configured weekday", function()
		local t = Schedule.nextMenuDropAt(1700000000)
		expect((t // 86400 + 4) % 7).toBe(Timings.MenuDrop.Weekday)
		expect(t % 86400).toBe(Timings.MenuDrop.HourUTC * 3600)
	end)
end)
